{
	"name": "stuco-website",
	"version": "1.3.4",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run build && npx gh-pages -d build --nojekyll",
		"download": "cd scripts && npm run download-images && cd ..",
		"postinstall": "patch-package"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^26.1.2",
		"dotenv": "^17.2.3",
		"gh-pages": "^6.3.0",
		"googleapis": "^173.0.0",
		"inquirer": "^14.0.1",
		"patch-package": "^8.0.1",
		"postinstall-postinstall": "^2.1.0",
		"sass": "^1.97.0",
		"supports-color": "^11.0.0",
		"svelte": "^5.46.0",
		"svelte-check": "^4.3.4",
		"ts-node": "^10.9.1",
		"tslib": "^2.6.2",
		"vite": "^8.0.3",
		"vite-imagetools": "^10.0.1"
	},
	"type": "module",
	"dependencies": {
		"remixicon": "^4.7.0",
		"svelte-confetti": "^2.3.2",
		"swiper": "^14.0.7"
	},
	"allowScripts": {
		"sharp@0.35.3": true,
		"@parcel/watcher@2.6.0": true,
		"postinstall-postinstall@2.1.0": true
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
